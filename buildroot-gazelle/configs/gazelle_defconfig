# Minimal gazelle image: aarch64 BusyBox + dropbear, zstd cpio initramfs.
# The kernel is NOT built here - you reuse the device's own vendor 5.15.x kernel
# (harvested from a CoreELEC gazelle image). See README + inputs/README.md.

# --- Architecture: Amlogic T7 (A311D2) = Cortex-A73 + A53 ---
BR2_aarch64=y
BR2_cortex_a73_a53=y

# --- Toolchain (internal glibc; headers match the running 5.15 kernel) ---
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_5_15=y

# --- Init / system ---
BR2_INIT_BUSYBOX=y
BR2_TARGET_GENERIC_HOSTNAME="gazelle"
BR2_TARGET_GENERIC_ISSUE="Fire TV Cube 3rd gen (gazelle) - minimal Buildroot"
# Default root password for first-boot password auth. CHANGE THIS, or use an SSH key
# (set GAZELLE_SSH_PUBKEY at build time - see post-build.sh / README).
BR2_TARGET_GENERIC_ROOT_PASSWD="gazelle"
BR2_SYSTEM_BIN_SH_BUSYBOX=y
# serial console getty on the Amlogic UART (speed inherited from kernel console=ttyS0,921600)
BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"

# --- Networking: DHCP on wired eth0 (Gigabit; MAC is built into the vendor kernel) ---
BR2_SYSTEM_DHCP="eth0"

# --- Packages ---
BR2_PACKAGE_DROPBEAR=y

# --- Overlay + post-build (injects optional SSH pubkey from $GAZELLE_SSH_PUBKEY) ---
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_GAZELLE_PATH)/board/gazelle/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_GAZELLE_PATH)/board/gazelle/post-build.sh"

# --- Output: zstd cpio initramfs (the vendor kernel ships CONFIG_RD_ZSTD) ---
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_ZSTD=y
# BR2_TARGET_ROOTFS_TAR is not set
